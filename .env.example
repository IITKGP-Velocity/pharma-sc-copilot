# ============================================================
# Copy this file to .env and fill in the values from the university.
# Leave a value BLANK if you do not have it yet: the feature turns off and the app still runs.
# Never commit .env. Never share these values in screenshots or reports.
# ============================================================

# University chat endpoint (small model, OpenAI-compatible)
# Endpoint is the base URL ending in /v1. CA_CERT is the endpoint's CA file, absolute or relative to
# this folder (for example secrets/vm04-ca.crt). Leave CA_CERT blank only for publicly signed endpoints.
# API keys do NOT go in this file (it ignores them). Each person passes their key at run time:
# the scripts ask for it with a hidden prompt, or export COPILOT_CHAT_API_KEY in your shell session.
COPILOT_CHAT_ENDPOINT=
COPILOT_MODEL_NAME=
COPILOT_CHAT_CA_CERT=

# University embeddings endpoint (OpenAI-compatible). Key: COPILOT_EMBED_API_KEY, passed the same way.
COPILOT_EMBED_ENDPOINT=
COPILOT_EMBED_MODEL=
COPILOT_EMBED_CA_CERT=

# Optional: openFDA key (export OPENFDA_API_KEY in your shell; the public API works without one)
